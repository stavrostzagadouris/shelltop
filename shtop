SPARK_CHARS = " ▁▂▃▄▅▆▇█"


class Quit(Exception):
    pass


class App:
    def __init__(self, refresh_ms, theme_idx):
        self.refresh_ms = refresh_ms
        self.theme_idx = theme_idx
        self.C = THEMES[theme_idx]
        self.sort_by = "CPU"
        self.show_per_core = True
        self.sel = 0             # selected row, as an index into the whole sorted list
        self.sel_pid = None      # set once you move the selection: the highlight follows it
        self.scroll_top = 0      # index of the first visible row
        self.rows = 10
        self.sorted = []
        self.kill_target = None  # (pid, name) awaiting confirmation
        self.status_msg = ""
        self.status_until = 0.0
        self.displayed = []
        self.filter_text = ""
        self.filter_mode = False
        self.last_size = None
        self.resized = False

        self.hostname = socket.gethostname()
        self.cpu_name = get_cpu_name()
        self.logical_cores = os.cpu_count() or 1
        self.cpu = CpuSampler()
        self.sensors = CpuSensors()
        self.procs = ProcSampler()
        self.gpu = None
        try:
            self.gpu = make_gpu()
        except Exception:
            self.gpu = None

        self.cpu_hist, self.gpu_hist = [], []
        self.prev_net = get_net_counters()[:2]
        self.prev_net_t = time.monotonic()
        self.prev_disk = get_diskstats()
        self.prev_disk_t = time.monotonic()
        self.snap = None

    # ── colors / small formatters ──
    def meter_color(self, pct):
        C = self.C
        if pct < 40:
            return C.Green
        if pct < 70:
            return C.Cyan
        if pct < 85:
            return C.Yellow
        return C.Red

    def temp_color(self, t):
        C = self.C
        if t < 55:
            return C.Green
        if t < 72:
            return C.Yellow
        if t < 83:
            return C.Orange
        return C.Red

    def bar(self, pct, width, color=""):
        if width < 2:
            return ""
        pct = clamp(pct)
        color = color or self.meter_color(pct)
        filled = int(round(pct / 100.0 * width))
        return f"{color}{'█' * filled}{self.C.Dim}{'░' * (width - filled)}{self.C.Reset}"

    def sparkline(self, hist, width, color):
        if width < 1:
            return ""
        out = [color]
        n = len(hist)
        for i in range(n - width, n):
            if i < 0:
                out.append("·")
            else:
                out.append(SPARK_CHARS[int(round(clamp(hist[i]) / 100.0 * 8))])
        out.append(self.C.Reset)
        return "".join(out)

    @staticmethod
    def fmt_rate(bps):
        if bps >= 100 * MB:
            s = f"{bps / MB:.0f}M/s"
        elif bps >= MB:
            s = f"{bps / MB:.1f}M/s"
        else:
            s = f"{bps / KB:.0f}K/s"
        return s.rjust(7)

    def fmt_battery(self, bat):
        if not bat:
            return ""
        C = self.C
        pct, status, secs = bat
        col = C.Green if pct > 50 else (C.Yellow if pct > 20 else C.Red)
        if status == "Charging":
            state = "charging"
        elif status == "Discharging":
            state = f"{secs // 3600}h {secs % 3600 // 60:02d}m left" if secs else "on battery"
        else:
            state = "AC"
        return f" {C.Dim}│ Bat: {col}{pct}% {C.Dim}({state})"

    @staticmethod
    def pad_ansi(s, width):
        clean = ANSI_RE.sub("", s)
        if len(clean) > width:
            return clean[:max(0, width - 1)] + "…"
        return s + " " * (width - len(clean))

    def box_line(self, left, lw, right, rw):
        C = self.C
        return (f"{C.Border}│{C.Reset} {self.pad_ansi(left, lw)} {C.Border}││{C.Reset} "
                f"{self.pad_ansi(right, rw)} {C.Border}│{C.Reset}")

    def full_line(self, content, inner):
        C = self.C
        return f"{C.Border}│{C.Reset} {self.pad_ansi(content, inner)} {C.Border}│{C.Reset}"

    @staticmethod
    def join_fit(segments, width):
        """Concatenate segments left to right, stopping before the first that would overflow."""
        out, used = "", 0
        for seg in segments:
            n = visible_len(seg)
            if used + n > width:
                break
            out, used = out + seg, used + n
        return out

    def set_status(self, msg, secs):
        self.status_msg = msg
        self.status_until = time.monotonic() + secs

    def close(self):
        if self.gpu and hasattr(self.gpu, "close"):
            self.gpu.close()

    # ── data collection ──
    def collect(self):
        s = {}
        s["cpu_pct"], s["cores"] = self.cpu.sample()
        mem = get_meminfo()
        s["ram_total"] = mem.get("MemTotal", 1)
        s["ram_used"] = s["ram_total"] - mem.get("MemAvailable", 0)
        s["ram_pct"] = s["ram_used"] / s["ram_total"] * 100.0
        s["swap_total"] = mem.get("SwapTotal", 0)
        s["swap_used"] = s["swap_total"] - mem.get("SwapFree", 0)
        s["swap_pct"] = s["swap_used"] / s["swap_total"] * 100.0 if s["swap_total"] else 0.0
        try:
            s["sens"] = self.sensors.sample()
        except OSError:
            s["sens"] = {"Temp": None, "Tag": "", "PowerW": None, "ClockMHz": None, "CoreTemps": {}}

        procs, pids = self.procs.sample(s["ram_total"], self.logical_cores)
        s["procs"], s["proc_count"] = procs, len(pids)

        gpu = new_gpu_stats()
        if self.gpu:
            try:
                self.gpu.refresh_ms = self.refresh_ms
                gpu = self.gpu.sample(pids)
            except Exception:
                pass
        s["gpu"] = gpu
        s["vram_pct"] = gpu["MemUsedMB"] / gpu["MemTotMB"] * 100.0 if gpu["MemTotMB"] else 0.0

        for hist, val in ((self.cpu_hist, s["cpu_pct"]), (self.gpu_hist, gpu["Util"])):
            hist.append(val)
            if len(hist) > 120:
                del hist[0]

        now = time.monotonic()
        try:
            rx, tx, s["net_label"] = get_net_counters()
        except OSError:
            (rx, tx), s["net_label"] = self.prev_net, ""
        dt = max(0.1, now - self.prev_net_t)
        s["rx_bps"] = max(0.0, (rx - self.prev_net[0]) / dt)
        s["tx_bps"] = max(0.0, (tx - self.prev_net[1]) / dt)
        s["rx_total"], s["tx_total"] = rx, tx
        self.prev_net, self.prev_net_t = (rx, tx), now

        try:
            s["disks"] = get_disks()
        except OSError:
            s["disks"] = []
        rates = {}
        try:
            ds = get_diskstats()
            ddt = max(0.1, now - self.prev_disk_t)
            for k, (rd, wr) in ds.items():
                if k in self.prev_disk:
                    rates[k] = (max(0.0, (rd - self.prev_disk[k][0]) / ddt),
                                max(0.0, (wr - self.prev_disk[k][1]) / ddt))
            self.prev_disk, self.prev_disk_t = ds, now
        except OSError:
            pass
        s["disk_rates"] = rates

        try:
            s["battery"] = get_battery()
        except OSError:
            s["battery"] = None
        try:
            s["uptime"] = float(read_text("/proc/uptime", "0").split()[0])
        except (ValueError, IndexError):
            s["uptime"] = 0.0
        self.snap = s

    # ── rendering ──
    def render(self):
        C, s = self.C, self.snap
        term_w, term_h = shutil.get_terminal_size((100, 30))
        if (term_w, term_h) != self.last_size:
            self.last_size = (term_w, term_h)
            sys.stdout.buffer.write(f"{ESC}[2J".encode())
        win_w, win_h = max(84, term_w), max(24, term_h)
        avail_w = win_w - 8
        lw = avail_w // 2
        rw = avail_w - lw
        full_w = win_w - 4
        gpu = s["gpu"]
        gpu_pids = gpu["GpuPids"]
        lines = []

        # Header bar
        clock = datetime.now().strftime("%H:%M:%S")
        up = int(s["uptime"])
        up_str = f"{up // 86400}d {up % 86400 // 3600:02d}h {up % 3600 // 60:02d}m"
        banner = f" │ {C.Orange}{self.status_msg}" if time.monotonic() < self.status_until else ""
        hdr_l = (f"{C.Title} shtop {C.Dim}│ {C.Cyan}{self.hostname} {C.Dim}│ Up: {C.Text}{up_str}"
                 f"{self.fmt_battery(s['battery'])} {C.Dim}│ {C.Yellow}{self.refresh_ms}ms{banner}")
        hdr_r = (f"{C.Dim}[{C.Yellow}P{C.Dim}]Cores [{C.Yellow}T{C.Dim}]heme [{C.Yellow}C/M/G/I{C.Dim}]Sort "
                 f"[{C.Yellow}↑↓/K{C.Dim}]Kill [{C.Yellow}Q{C.Dim}]uit │ {C.Cyan}{clock} ")
        len_l, len_r = visible_len(hdr_l), visible_len(hdr_r)
        if len_l + len_r + 1 > win_w:   # narrow window: drop the key hints instead of wrapping
            hdr_r = f"{C.Cyan}{clock} "
            len_r = len(clock) + 1
        if len_l + len_r > win_w:
            hdr_l = self.pad_ansi(hdr_l, max(1, win_w - len_r - 1))
            len_l = visible_len(hdr_l)
        lines.append(hdr_l + " " * max(1, win_w - len_l - len_r) + hdr_r + C.Reset)

        # ── ROW 1: CPU (left) & GPU (right) ──
        def titled(label, sub, width):
            room = max(3, width + 2 - len(label) - 6)   # "─ LABEL (" + sub + ") "
            if len(sub) > room:
                sub = sub[:room - 1] + "…"
            return f"─{C.Title} {label} {C.SubTitle}({sub}) {C.Border}"

        pstate = f" [{gpu['PState']}]" if gpu["PState"] else ""
        cpu_t = titled("CPU", self.cpu_name, lw)
        gpu_t = titled("GPU", gpu["Name"] + pstate, rw)
        lines.append(f"{C.Border}╭{cpu_t}{'─' * max(0, lw + 2 - visible_len(cpu_t))}╮╭{gpu_t}"
                     f"{'─' * max(0, rw + 2 - visible_len(gpu_t))}╮{C.Reset}")

        bar_w = max(10, lw - 22)
        rbar_w = max(10, rw - 26)
        spark_w = max(10, lw - 12)
        rspark_w = max(10, rw - 12)

        cpu_pct, util = s["cpu_pct"], gpu["Util"]
        l1 = f"{C.Text}CPU Total  {self.bar(cpu_pct, bar_w)} {self.meter_color(cpu_pct)}{cpu_pct:5.1f}%{C.Reset}"
        r1 = f"{C.Text}GPU Core   {self.bar(util, rbar_w)} {self.meter_color(util)}{util:5.1f}%{C.Reset}"
        lines.append(self.box_line(l1, lw, r1, rw))

        l2 = f"{C.Dim}History    {self.sparkline(self.cpu_hist, spark_w, self.meter_color(cpu_pct))}"
        r2 = f"{C.Dim}History    {self.sparkline(self.gpu_hist, rspark_w, self.meter_color(util))}"
        lines.append(self.box_line(l2, lw, r2, rw))

        l3 = (f"{C.Text}RAM        {self.bar(s['ram_pct'], bar_w)} {C.Cyan}"
              f"{s['ram_used'] / GB:4.1f}/{s['ram_total'] / GB:.1f}G{C.Reset}")
        if gpu["MemTotMB"]:
            r3 = (f"{C.Text}VRAM       {self.bar(s['vram_pct'], rbar_w - 4)} {C.Magenta}"
                  f"{gpu['MemUsedMB'] / 1024:4.1f}/{gpu['MemTotMB'] / 1024:.1f}G ({s['vram_pct']:.0f}%){C.Reset}")
        else:
            r3 = f"{C.Text}VRAM       {C.Dim}N/A (shared system memory){C.Reset}"
        lines.append(self.box_line(l3, lw, r3, rw))

        l4 = (f"{C.Text}Swap       {self.bar(s['swap_pct'], bar_w)} {C.Dim}"
              f"{s['swap_used'] / GB:4.1f}/{s['swap_total'] / GB:.1f}G{C.Reset}")
        pw, pcap = gpu["PowerW"], gpu["PowerCapW"]
        if pw is not None and pcap:
            r4 = (f"{C.Text}Power      {self.bar(pw / pcap * 100.0, rbar_w - 4, C.Yellow)} {C.Yellow}"
                  f"{pw:5.1f}/{pcap:.0f}W{C.Reset}")
        elif pw is not None:
            r4 = f"{C.Text}Power      {C.Yellow}{pw:5.1f}W{C.Reset}"
        else:
            r4 = f"{C.Text}Power      {C.Dim}N/A{C.Reset}"
        lines.append(self.box_line(l4, lw, r4, rw))

        # Sensor readouts are appended only while they fit, so a narrow window drops them cleanly
        sens = s["sens"]
        segs = [f"{C.Dim}Cores: {C.Text}{self.logical_cores}", f"  {C.Dim}Procs: {C.Text}{s['proc_count']}"]
        if sens["Temp"] is not None:
            segs.append(f"  {C.Dim}Temp: {self.temp_color(sens['Temp'])}{sens['Temp']:.0f}°C"
                        f"{C.Dim}{sens['Tag']}")
        if sens["PowerW"] is not None:
            segs.append(f"  {C.Dim}Pwr: {C.Yellow}{sens['PowerW']:.0f}W")
        if sens["ClockMHz"] is not None:
            segs.append(f"  {C.Dim}Clk: {C.Green}{sens['ClockMHz'] / 1000.0:.2f}GHz")
        l5 = self.join_fit(segs, lw)
        parts = []
        if gpu["Temp"] is not None:
            parts.append(f"{C.Dim}Temp: {self.temp_color(gpu['Temp'])}{gpu['Temp']:.0f}°C")
        if gpu["FanPct"] is not None:
            parts.append(f"{C.Dim}Fan: {C.Cyan}{gpu['FanPct']:.0f}%")
        if gpu["ClockCore"]:
            mem_clk = f"{C.Dim}/{C.Magenta}{gpu['ClockMem']}" if gpu["ClockMem"] else ""
            parts.append(f"{C.Dim}Clocks: {C.Green}{gpu['ClockCore']}{mem_clk}MHz")
        if gpu["MemUtil"] is not None:
            parts.append(f"{C.Dim}MemCtrl: {C.Text}{gpu['MemUtil']:.0f}%")
        r5 = "  ".join(parts) if parts else f"{C.Dim}Temp/Fan/Clocks: N/A"
        lines.append(self.box_line(l5, lw, r5, rw))

        extra = 0
        cores = s["cores"]
        if self.show_per_core and cores:
            ct = f"─{C.Title} Per-Core CPU Utilization {C.Border}"
            lines.append(f"{C.Border}├{ct}{'─' * max(0, lw + 2 - visible_len(ct))}┴"
                         f"{'─' * (rw + 3)}┤{C.Reset}")
            extra += 1
            cols = 4
            cell_w = (full_w - (cols - 1) * 2) // cols
            # Per-core temperature beside each bar, when the sensors have them and there's room
            core_temps = sens["CoreTemps"]
            show_core_t = bool(core_temps) and cell_w >= 19
            mini_w = max(4, cell_w - (15 if show_core_t else 11))
            for i in range(0, len(cores), cols):
                cells = []
                for idx, cp in cores[i:i + cols]:
                    core_t = ""
                    if show_core_t:
                        ct = core_temps.get(idx)
                        core_t = f" {self.temp_color(ct)}{ct:2.0f}°" if ct is not None else "    "
                    cell = (f"{C.Dim}C{idx:<2}{C.Reset} {self.bar(cp, mini_w)} "
                            f"{self.meter_color(cp)}{cp:4.0f}%{core_t}{C.Reset}")
                    cells.append(self.pad_ansi(cell, cell_w))
                cells += [" " * cell_w] * (cols - len(cells))
                lines.append(self.full_line("  ".join(cells), full_w))
                extra += 1

        # ── ROW 2: DISKS (left) & NETWORK (right) ──
        dt_ = f"─{C.Title} Disks {C.Border}"
        net_label = s["net_label"]
        if len(net_label) > 24:
            net_label = net_label[:23] + "…"
        nt_ = (f"─{C.Title} Network {C.SubTitle}({net_label}) {C.Border}" if net_label
               else f"─{C.Title} Network {C.Border}")
        if self.show_per_core and cores:
            mid = (f"{C.Border}├{dt_}{'─' * max(0, lw + 2 - visible_len(dt_))}┬{nt_}"
                   f"{'─' * max(0, rw + 3 - visible_len(nt_))}┤{C.Reset}")
        else:
            mid = (f"{C.Border}├{dt_}{'─' * max(0, lw + 2 - visible_len(dt_))}┤├{nt_}"
                   f"{'─' * max(0, rw + 2 - visible_len(nt_))}┤{C.Reset}")
        lines.append(mid)

        disks = s["disks"][:6]
        disk_rows = max(2, len(disks))
        label_w = min(10, max([4] + [len(d["mnt"]) for d in disks]))
        dsk_lines = []
        for d in disks:
            label = d["mnt"] if len(d["mnt"]) <= label_w else d["mnt"][:label_w - 1] + "…"
            io = s["disk_rates"].get(d["kname"])
            io_str = (f" {C.Green}R{self.fmt_rate(io[0])} {C.Yellow}W{self.fmt_rate(io[1])}"
                      if io else "")
            dbar_w = max(4, lw - 38 - (label_w - 4))
            dsk_lines.append(f"{C.Text}{label.ljust(label_w)}{self.bar(d['pct'], dbar_w)} {C.Cyan}"
                             f"{d['used'] / GB:4.0f}/{d['total'] / GB:.0f}G {d['pct']:3.0f}%{io_str}{C.Reset}")
        dsk_lines += [""] * (disk_rows - len(dsk_lines))

        def rate_str(bps):
            kbs = bps / KB
            return f"{kbs / 1024:.2f} MB/s" if kbs >= 1024 else f"{kbs:.1f} KB/s"

        net_lines = [
            f"{C.Green}▼ Download {C.Text}{rate_str(s['rx_bps']).ljust(14)} {C.Dim}Total RX: "
            f"{C.Text}{s['rx_total'] / GB:.2f} GB",
            f"{C.Yellow}▲ Upload   {C.Text}{rate_str(s['tx_bps']).ljust(14)} {C.Dim}Total TX: "
            f"{C.Text}{s['tx_total'] / GB:.2f} GB",
        ]
        net_lines += [""] * (disk_rows - len(net_lines))
        for dl, nl in zip(dsk_lines, net_lines):
            lines.append(self.box_line(dl, lw, nl, rw))
        lines.append(f"{C.Border}╰{'─' * (lw + 2)}╯╰{'─' * (rw + 2)}╯{C.Reset}")

        # ── ROW 3: PROCESSES (full width) ──
        procs = s["procs"]
        if self.filter_text:
            ft = self.filter_text.lower()
            procs = [p for p in procs if ft in p.name.lower() or str(p.pid).startswith(self.filter_text)]
        if self.sort_by == "MEM":
            procs = sorted(procs, key=lambda p: p.mem_mb, reverse=True)
        elif self.sort_by == "GPU":
            procs = sorted(procs, key=lambda p: (p.pid in gpu_pids, gpu_pids.get(p.pid, -1),
                                                 p.cpu, p.mem_mb), reverse=True)
        elif self.sort_by == "IO":
            procs = sorted(procs, key=lambda p: (p.io or 0.0, p.cpu, p.mem_mb), reverse=True)
        else:
            procs = sorted(procs, key=lambda p: (p.cpu, p.mem_mb), reverse=True)
        self.sorted = procs
        total = len(procs)

        # Once the selection has been moved it is tied to a PID, so the highlight follows
        # that process as the list re-sorts. Untouched, it simply stays on the top row.
        if self.sel_pid is not None:
            found = next((i for i, p in enumerate(procs) if p.pid == self.sel_pid), -1)
            if found >= 0:
                self.sel = found
            else:
                # The process is gone: drop any pending kill, keep the highlight where it was
                if self.kill_target:
                    self.kill_target = None
                    self.set_status("Process already exited", 3)
                self.sel_pid = None
        self.sel = max(0, min(self.sel, total - 1))
        if self.sel_pid is None and self.sel > 0:
            self.sel_pid = procs[self.sel].pid

        # Scroll the window so the selected row stays visible
        used = 15 + extra + (disk_rows - 2)
        rows = self.rows = max(3, win_h - used)
        if self.sel < self.scroll_top:
            self.scroll_top = self.sel
        if self.sel >= self.scroll_top + rows:
            self.scroll_top = self.sel - rows + 1
        self.scroll_top = max(0, min(self.scroll_top, total - rows))
        self.displayed = procs[self.scroll_top:self.scroll_top + rows]
        pos = f"{self.sel + 1}/{total}" if total else "0/0"

        if self.filter_mode:
            ftag = (f"Filter: {C.Yellow}{self.filter_text}{C.Text}_ {C.Dim}[Enter]Keep [Esc]Clear"
                    f"{C.SubTitle}")
        elif self.filter_text:
            ftag = f"Filter: {C.Yellow}{self.filter_text} {C.Dim}[Esc]Clear{C.SubTitle}"
        else:
            ftag = f"[{C.Yellow}/{C.SubTitle}]Filter"
        pt = (f"─{C.Title} Processes {C.SubTitle}(Sort: {C.Yellow}{self.sort_by}{C.SubTitle} │ "
              f"{C.Text}{pos}{C.SubTitle} │ {ftag} │ "
              f"GPU Apps: {C.Green}{len(gpu_pids)}{C.SubTitle} │ Theme: {C.Cyan}{C.Name}{C.SubTitle}) "
              f"{C.Border}")
        lines.append(f"{C.Border}╭{pt}{'─' * max(0, full_w + 2 - visible_len(pt))}╮{C.Reset}")

        # Threads and disk I/O columns appear only when the window is wide enough for them
        show_io = full_w >= 92
        name_w = max(18, full_w - (74 if show_io else 58))
        io_hdr = f"{'THR':>4}  {'DISK IO':>8}  " if show_io else ""
        hdr = (f"{'PID':>7}  {'PROCESS NAME':<{name_w}}  {'CPU %':>7}  {'MEM (MB)':>9}  "
               f"{'MEM %':>6}  {io_hdr}GPU STATUS")
        lines.append(self.full_line(f"{C.HeaderBg}{hdr.ljust(full_w)}{C.Reset}", full_w))

        short = gpu["ShortName"]
        kill_bg = _bg((150, 30, 40)) + _fg((255, 255, 255), True)
        for r, p in enumerate(self.displayed):
            name = p.name if len(p.name) <= name_w else p.name[:name_w - 1] + "…"
            on_gpu = p.pid in gpu_pids
            g_pct = gpu_pids.get(p.pid, 0)
            g_text = (f"● {short} ({g_pct}%)" if g_pct > 0 else f"● {short} (Active)") if on_gpu else "·"
            # "?" = not readable without root (another user's process)
            io_text = ("?" if p.io is None else self.fmt_rate(p.io) if p.io >= 512 else "·").rjust(8)
            if self.kill_target and p.pid == self.kill_target[0]:
                # Confirmation prompt, drawn on the row that is about to be killed
                ask = (f" Kill {self.kill_target[1]} (PID {p.pid})?   [Y] SIGTERM   [9] SIGKILL   "
                       f"any other key cancels")
                lines.append(self.full_line(f"{kill_bg}{ask[:full_w].ljust(full_w)}{C.Reset}", full_w))
            elif self.scroll_top + r == self.sel:
                io_plain = f"{p.threads:>4}  {io_text}  " if show_io else ""
                plain = (f"{p.pid:>7}  {name:<{name_w}}  {p.cpu:6.1f}%  {p.mem_mb:8.1f}M  "
                         f"{p.mem_pct:5.1f}%  {io_plain}{g_text}")
                lines.append(self.full_line(f"{C.SelBg}{plain.ljust(full_w)}{C.Reset}", full_w))
            else:
                badge = f"{C.GpuTag}{g_text}{C.Reset}" if on_gpu else f"{C.Dim}·{C.Reset}"
                io_cells = ""
                if show_io:
                    io_col = (C.Dim if not p.io or p.io < 512 else
                              C.Yellow if p.io >= 10 * MB else C.Text)
                    io_cells = f"{C.Dim}{p.threads:>4}  {io_col}{io_text}  "
                row = (f"{C.Dim}{p.pid:>7}  {C.Text}{name.ljust(name_w)}  "
                       f"{self.meter_color(p.cpu * 2)}{p.cpu:6.1f}%  {C.Cyan}{p.mem_mb:8.1f}M  "
                       f"{self.meter_color(p.mem_pct * 2)}{p.mem_pct:5.1f}%  {io_cells}{badge}")
                lines.append(self.full_line(row, full_w))
        if self.filter_text and not self.displayed:
            lines.append(self.full_line(f"{C.Dim}  No processes match '{self.filter_text}'", full_w))

        lines.append(f"{C.Border}╰{'─' * (full_w + 2)}╯{C.Reset}")
        frame = f"{ESC}[H" + "\n".join(lines) + f"{ESC}[J"
        sys.stdout.buffer.write(frame.encode("utf-8", "replace"))
        sys.stdout.flush()

    # ── input ──
    def request_kill(self):
        """Kills are two-step: this only records the target (by PID, from the frame on screen)."""
        if self.sel < len(self.sorted):
            p = self.sorted[self.sel]
            self.kill_target = (p.pid, p.name)
            self.sel_pid = p.pid

    def send_signal(self, pid, name, sig):
        try:
            os.kill(pid, sig)
            if sig == signal.SIGKILL:
                msg = f"Killed {name} (PID {pid}) with SIGKILL"
                # Drop it from the cached list so it disappears now, not at the next sample
                self.snap["procs"] = [p for p in self.snap["procs"] if p.pid != pid]
                self.sel_pid = None
            else:
                msg = f"Sent SIGTERM to {name} (PID {pid})"
        except PermissionError:
            msg = f"Failed to kill PID {pid}: Permission denied"
        except ProcessLookupError:
            msg = f"PID {pid} has already exited"
        self.set_status(msg, 3)

    def set_sel(self, idx):
        if self.sorted:
            self.sel = max(0, min(len(self.sorted) - 1, idx))
            self.sel_pid = self.sorted[self.sel].pid

    def reset_sel(self):
        self.sel, self.sel_pid, self.scroll_top = 0, None, 0

    def handle_key(self, k):
        # A kill is waiting for confirmation: [Y] / [9] go through, any other key cancels
        if self.kill_target:
            (pid, name), self.kill_target = self.kill_target, None
            if k in ("y", "Y"):
                self.send_signal(pid, name, signal.SIGTERM)
            elif k == "9":
                self.send_signal(pid, name, signal.SIGKILL)
            else:
                self.set_status("Kill cancelled", 3)
            return
        if self.filter_mode:
            if k == "ENTER":
                self.filter_mode = False
            elif k == "ESC":
                self.filter_mode, self.filter_text = False, ""
            elif k == "BS":
                self.filter_text = self.filter_text[:-1]
            elif len(k) == 1 and k.isprintable():
                self.filter_text += k
            self.reset_sel()
            return
        if k == "/":
            self.filter_mode = True
            self.reset_sel()
            return
        k = k.lower() if len(k) == 1 else k
        if k == "q":
            raise Quit()
        if k == "ESC":
            if self.filter_text:
                self.filter_text = ""
                self.reset_sel()
            else:
                raise Quit()
        elif k in ("c", "m", "g", "i"):
            self.sort_by = {"c": "CPU", "m": "MEM", "g": "GPU", "i": "IO"}[k]
            self.reset_sel()
        elif k == "p":
            self.show_per_core = not self.show_per_core
        elif k == "t":
            self.theme_idx = (self.theme_idx + 1) % len(THEMES)
            self.C = THEMES[self.theme_idx]
            self.set_status(f"Theme: {self.C.Name}", 2)
        elif k == "UP":
            self.set_sel(self.sel - 1)
        elif k == "DOWN":
            self.set_sel(self.sel + 1)
        elif k == "PGUP":
            self.set_sel(self.sel - self.rows)
        elif k == "PGDN":
            self.set_sel(self.sel + self.rows)
        elif k == "HOME":
            self.reset_sel()
        elif k == "END":
            self.set_sel(len(self.sorted) - 1)
        elif k in ("k", "DEL"):
            self.request_kill()
        elif k in ("+", "="):
            self.refresh_ms = max(250, self.refresh_ms - 250)
        elif k in ("-", "_"):
            self.refresh_ms = min(5000, self.refresh_ms + 250)

    @staticmethod
    def parse_keys(data):
        seqs = {"\x1b[A": "UP", "\x1bOA": "UP", "\x1b[B": "DOWN", "\x1bOB": "DOWN", "\x1b[3~": "DEL",
                "\x1b[5~": "PGUP", "\x1b[6~": "PGDN",
                "\x1b[H": "HOME", "\x1bOH": "HOME", "\x1b[1~": "HOME", "\x1b[7~": "HOME",
                "\x1b[F": "END", "\x1bOF": "END", "\x1b[4~": "END", "\x1b[8~": "END"}
        keys, i = [], 0
        while i < len(data):
            c = data[i]
            if c == "\x1b":
                if i + 1 < len(data) and data[i + 1] in "[O":
                    j = i + 2
                    while j < len(data) and not (data[j].isalpha() or data[j] == "~"):
                        j += 1
                    keys.append(seqs.get(data[i:j + 1], ""))
                    i = j + 1
                    continue
                keys.append("ESC")
            elif c in "\r\n":
                keys.append("ENTER")
            elif c in "\x7f\x08":
                keys.append("BS")
            else:
                keys.append(c)
            i += 1
        return [k for k in keys if k]

    def read_input(self, fd):
        data = os.read(fd, 256)
        # A lone ESC may be the start of an arrow-key sequence split across reads
        if data.endswith(b"\x1b") and select.select([fd], [], [], 0.03)[0]:
            data += os.read(fd, 256)
        for k in self.parse_keys(data.decode("utf-8", "replace")):
            self.handle_key(k)

    def run(self):
        fd = sys.stdin.fileno()
        next_sample = 0.0
        while True:
            if time.monotonic() >= next_sample:
                start = time.monotonic()
                self.collect()
                next_sample = start + self.refresh_ms / 1000.0
            self.render()
            # Wait out the interval, but redraw at once on a key press or resize
            while True:
                remain = next_sample - time.monotonic()
                if remain <= 0 or self.resized:
                    self.resized = False
                    break
                try:
                    ready = select.select([fd], [], [], min(remain, 0.1))[0]
                except InterruptedError:
                    continue
                if ready:
                    self.read_input(fd)
                    break


def main():
    ap = argparse.ArgumentParser(prog="shtop", description="Zero-root system & GPU monitor for Linux.")
    ap.add_argument("-r", "--refresh-ms", type=int, default=1000,
                    help="refresh interval in milliseconds (250-5000, default 1000)")
    ap.add_argument("-t", "--theme", default="Midnight",
                    choices=[t.Name for t in THEMES], type=lambda s: s.capitalize(),
                    help="starting color theme")
    args = ap.parse_args()

    if not os.path.exists("/proc/stat"):
        sys.exit("shtop needs Linux (/proc not found).")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        sys.exit("shtop needs an interactive terminal.")

    refresh = max(250, min(5000, args.refresh_ms))
    theme_idx = next(i for i, t in enumerate(THEMES) if t.Name == args.theme)
    app = App(refresh, theme_idx)

    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)

    def on_winch(_sig, _frm):
        app.resized = True

    def on_term(_sig, _frm):
        raise Quit()

    signal.signal(signal.SIGWINCH, on_winch)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGHUP, on_term)

    crash = None
    try:
        tty.setcbreak(fd)
        sys.stdout.buffer.write(f"{ESC}[?1049h{ESC}[?25l{ESC}[2J".encode())
        sys.stdout.flush()
        app.run()
    except (Quit, KeyboardInterrupt):
        pass
    except Exception:
        crash = traceback.format_exc()
    finally:
        app.close()
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        sys.stdout.buffer.write(f"{ESC}[?25h{ESC}[?1049l{ESC}[0m".encode())
        sys.stdout.flush()
    if crash:
        sys.stderr.write("shtop crashed:\n" + crash)
        sys.exit(1)


if __name__ == "__main__":
    main()
