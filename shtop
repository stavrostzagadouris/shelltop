PCI_IDS_PATHS = ("/usr/share/hwdata/pci.ids", "/usr/share/misc/pci.ids", "/usr/share/pci.ids")
VENDOR_NAMES = {"0x1002": "AMD", "0x8086": "Intel", "0x10de": "NVIDIA"}


def pci_device_name(vendor, device):
    v = vendor.lower().replace("0x", "")
    d = device.lower().replace("0x", "")
    for path in PCI_IDS_PATHS:
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                in_vendor = False
                for line in f:
                    if not line.strip() or line[0] == "#":
                        continue
                    if line[0] != "\t":
                        if in_vendor:
                            return None
                        in_vendor = line.startswith(v + "  ")
                    elif in_vendor and line[1] != "\t" and line[1:].startswith(d + "  "):
                        return line[1:].split("  ", 1)[1].strip()
        except OSError:
            continue
    return None


def short_gpu_name(name):
    m = re.search(r"(RX|RTX|GTX|Arc)\s+\S+", name)
    if m:
        return m.group(0)
    s = re.sub(r"^(AMD|Intel|NVIDIA)\s+", "", name)
    s = re.sub(r"\s+Graphics", "", s).strip()
    return s or "GPU"


def new_gpu_stats(name="No GPU detected"):
    return {
        "Name": name, "ShortName": short_gpu_name(name), "Util": 0.0, "MemUtil": None,
        "MemUsedMB": 0.0, "MemTotMB": None, "Temp": None, "PowerW": None, "PowerCapW": None,
        "FanPct": None, "ClockCore": None, "ClockMem": None, "PState": "", "GpuPids": {},
    }


class LineStream:
    """A long-running child whose stdout is read on a daemon thread, keeping the newest sample.

    If shtop dies, the pipe closes and the child is killed by SIGPIPE on its next write,
    so nothing is left running.
    """

    def __init__(self, argv, grouped=False):
        self.grouped = grouped            # lines sharing a first token form one sample
        self.lock = threading.Lock()
        self.last_line = None
        self.last_time = None
        self.group, self.last_group, self.key = [], None, None
        self.started = time.monotonic()
        self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, universal_newlines=True, bufsize=1)
        self.thread = threading.Thread(target=self._pump, daemon=True)
        self.thread.start()

    def _pump(self):
        try:
            for line in self.proc.stdout:
                t = line.strip()
                if not t or t[0] == "#":
                    continue
                with self.lock:
                    self.last_time = time.monotonic()
                    if not self.grouped:
                        self.last_line = t
                        continue
                    key = t.split(None, 1)[0]
                    if key != self.key:
                        if self.key is not None:
                            self.last_group = self.group
                        self.group, self.key = [], key
                    self.group.append(t)
        except (OSError, ValueError):
            pass

    def age(self):
        """Seconds since the last line arrived (infinite if none has)."""
        with self.lock:
            return time.monotonic() - self.last_time if self.last_time else float("inf")

    def latest_line(self):
        with self.lock:
            return self.last_line

    def latest_group(self):
        # A sample's lines arrive in one burst, so a group that has been quiet for a
        # moment is complete even though the next one hasn't started yet.
        with self.lock:
            if self.group and time.monotonic() - self.last_time > 0.15:
                return list(self.group)
            return self.last_group

    def alive(self):
        return self.proc.poll() is None

    def close(self):
        try:
            self.proc.kill()
            self.proc.wait(timeout=1)
        except (OSError, subprocess.SubprocessError):
            pass


class NvidiaGpu:
    QUERY = ("name,utilization.gpu,utilization.memory,memory.used,memory.total,temperature.gpu,"
             "power.draw,power.limit,fan.speed,clocks.current.graphics,clocks.current.memory,pstate")
    RESTART_SEC = 5.0

    def __init__(self, smi):
        self.smi = smi
        self.refresh_ms = 1000
        # nvidia-smi runs as two long-lived streams rather than being spawned twice per
        # refresh. If a stream goes quiet, sample() falls back to a one-shot run.
        self.query = None
        self.query_ms = None
        self.pmon = None
        self.last_start = {"query": 0.0, "pmon": 0.0}

    def _run(self, *args):
        try:
            r = subprocess.run([self.smi, *args], stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, universal_newlines=True, timeout=5)
            return r.stdout
        except (OSError, subprocess.SubprocessError):
            return ""

    def _spawn(self, which, argv, grouped):
        """Start a stream, at most once per RESTART_SEC so a broken driver isn't hammered."""
        now = time.monotonic()
        if now - self.last_start[which] < self.RESTART_SEC:
            return None
        self.last_start[which] = now
        try:
            return LineStream([self.smi, *argv], grouped)
        except OSError:
            return None

    def _ensure_streams(self):
        ms = max(250, self.refresh_ms)
        if self.query and self.query.alive() and self.query_ms != ms:
            self.query.close()             # refresh rate changed: restart at the new rate
            self.last_start["query"] = 0.0
        if not self.query or not self.query.alive():
            first = self.query is None
            new = self._spawn("query", ["-i", "0", f"--query-gpu={self.QUERY}",
                                        "--format=csv,noheader,nounits", "-lms", str(ms)], False)
            if new:
                if self.query:
                    self.query.close()
                self.query, self.query_ms = new, ms
                if first:   # let the first sample arrive so the opening frame isn't blank
                    for _ in range(20):
                        if new.latest_line() or not new.alive():
                            break
                        time.sleep(0.05)
                    if not new.alive():
                        new.thread.join(0.3)   # it exited at once: collect the error it printed
        if not self.pmon or not self.pmon.alive():
            new = self._spawn("pmon", ["pmon", "-o", "T"], True)
            if new:
                if self.pmon:
                    self.pmon.close()
                self.pmon = new

    def close(self):
        for st in (self.query, self.pmon):
            if st:
                st.close()

    def sample(self, _pids):
        res = new_gpu_stats("NVIDIA GPU")
        self._ensure_streams()
        now = time.monotonic()
        stale = max(3.0, self.refresh_ms / 1000.0 * 2.5)

        q = self.query
        line = q.latest_line() if q and q.age() < stale else None
        if line is None and (q is None or now - q.started > 2):
            out = self._run(f"--query-gpu={self.QUERY}", "--format=csv,noheader,nounits")
            line = out.splitlines()[0] if out.strip() else None
        if line is None and q:
            line = q.latest_line()         # e.g. the NVML error it printed before exiting
        lines = [line] if line else []
        parts = [p.strip() for p in lines[0].split(",")] if lines else []
        if len(parts) >= 12:
            res["Name"] = parts[0]
            res["ShortName"] = short_gpu_name(parts[0])
            res["Util"] = to_float(parts[1]) or 0.0
            res["MemUtil"] = to_float(parts[2])
            res["MemUsedMB"] = to_float(parts[3]) or 0.0
            res["MemTotMB"] = max(1.0, to_float(parts[4]) or 1.0)
            res["Temp"] = to_float(parts[5])
            res["PowerW"] = to_float(parts[6])
            res["PowerCapW"] = to_float(parts[7])
            res["FanPct"] = to_float(parts[8])
            core, mem = to_float(parts[9]), to_float(parts[10])
            res["ClockCore"] = int(core) if core else None
            res["ClockMem"] = int(mem) if mem else None
            res["PState"] = parts[11]
        else:
            # nvidia-smi prints NVML errors (e.g. driver/library mismatch after a
            # driver update without a reboot) to stdout. Surface them in the panel.
            err = lines[0].strip() if lines else "nvidia-smi returned no data"
            err = re.sub(r"^Failed to initialize NVML:\s*", "", err)
            if "mismatch" in err.lower():
                err += " (reboot needed)"
            res["Name"] = f"NVIDIA: {err}"
            return res

        p = self.pmon
        group = p.latest_group() if p and p.age() < 5 else None
        if group is not None:
            pat = r"^\S+\s+\d+\s+(\d+)\s+(\S+)\s+(\S+)"      # time, gpu, pid, type, sm
        elif p is None or now - p.started > 3:
            group, pat = self._run("pmon", "-c", "1").splitlines(), r"^\s*\d+\s+(\d+)\s+(\S+)\s+(\S+)"
        else:
            group, pat = [], ""
        for pl in group:
            m = re.match(pat, pl)
            if m:
                res["GpuPids"][int(m.group(1))] = int(m.group(3)) if m.group(3).isdigit() else 0
        return res


class DrmClients:
    """Per-process GPU engine usage from /proc/<pid>/fdinfo (DRM client stats).

    Works for amdgpu, i915, xe and other DRM drivers that publish drm-engine-*
    keys. Only processes you own are readable without root, which is fine: that
    is everything you are running on your desktop.
    """
    RESCAN_SEC = 5.0

    def __init__(self, pdev):
        self.pdev = pdev
        self.fds = {}
        self.last_scan = 0.0
        self.prev = {}
        self.prev_t = None

    @staticmethod
    def _scan_fds(pid):
        base = f"/proc/{pid}/fd"
        found = []
        try:
            names = os.listdir(base)
        except OSError:
            return found
        for fd in names:
            try:
                if os.readlink(f"{base}/{fd}").startswith("/dev/dri/"):
                    found.append(fd)
            except OSError:
                pass
        return found

    def _read_fdinfo(self, pid, fd):
        try:
            with open(f"/proc/{pid}/fdinfo/{fd}") as f:
                text = f.read()
        except OSError:
            return None
        if "drm-client-id" not in text:
            return None
        cid = pdev = None
        ns, cap, cycles, total = {}, {}, {}, {}
        for line in text.splitlines():
            key, _, val = line.partition(":")
            val = val.strip()
            try:
                if key == "drm-client-id":
                    cid = val
                elif key == "drm-pdev":
                    pdev = val
                elif key.startswith("drm-engine-capacity-"):
                    cap[key[20:]] = int(val.split()[0])
                elif key.startswith("drm-engine-"):
                    ns[key[11:]] = int(val.split()[0])
                elif key.startswith("drm-total-cycles-"):
                    total[key[17:]] = int(val.split()[0])
                elif key.startswith("drm-cycles-"):
                    cycles[key[11:]] = int(val.split()[0])
            except (ValueError, IndexError):
                continue
        if cid is None or (pdev and self.pdev and pdev != self.pdev):
            return None
        engines = {e: (b, None, max(1, cap.get(e, 1))) for e, b in ns.items()}
        for e, b in cycles.items():          # xe reports cycles instead of ns
            if e in total:
                engines[e] = (b, total[e], 1)
        return cid, engines

    def sample(self, pids):
        now = time.monotonic()
        full = now - self.last_scan >= self.RESCAN_SEC
        if full:
            self.last_scan = now
        fds = {}
        for pid in pids:
            fds[pid] = self._scan_fds(pid) if (full or pid not in self.fds) else self.fds[pid]
        self.fds = fds

        cur = {}
        for pid, fd_list in fds.items():
            for fd in fd_list:
                info = self._read_fdinfo(pid, fd)
                if info and info[0] not in cur:
                    cur[info[0]] = (pid, info[1])

        dt_ns = (now - self.prev_t) * 1e9 if self.prev_t else None
        pid_eng, all_eng = {}, {}
        for cid, (pid, engines) in cur.items():
            pe = pid_eng.setdefault(pid, {})
            old = self.prev.get(cid)
            if not old or old[0] != pid or not dt_ns:
                continue
            for e, (busy, tot, cp) in engines.items():
                o = old[1].get(e)
                if not o:
                    continue
                if tot is None:
                    frac = (busy - o[0]) / (dt_ns * cp)
                else:
                    d_tot = tot - o[1]
                    frac = (busy - o[0]) / d_tot if d_tot > 0 else 0.0
                if frac > 0:
                    pe[e] = pe.get(e, 0.0) + frac
                    all_eng[e] = all_eng.get(e, 0.0) + frac
        self.prev, self.prev_t = cur, now

        pid_util = {pid: int(round(min(100.0, max(e.values(), default=0.0) * 100.0)))
                    for pid, e in pid_eng.items()}
        # Like Task Manager / ptop: adapter util = busiest engine type
        adapter = min(100.0, max(all_eng.values(), default=0.0) * 100.0)
        return pid_util, adapter


class DrmGpu:
    """AMD / Intel / other DRM GPUs via sysfs (no root)."""

    def __init__(self, card):
        self.card = card
        self.dev = card + "/device"
        self.vendor = read_text(self.dev + "/vendor", "")
        self.pdev = os.path.basename(os.path.realpath(self.dev))
        hw = sorted(glob.glob(self.dev + "/hwmon/hwmon*"))
        self.hwmon = hw[0] if hw else None
        self.clients = DrmClients(self.pdev)

        vend = VENDOR_NAMES.get(self.vendor, "")
        raw = read_text(self.dev + "/product_name") or \
            pci_device_name(self.vendor, read_text(self.dev + "/device", ""))
        if raw:
            m = re.search(r"\[([^\]]+)\]", raw)
            nice = m.group(1) if m else raw
            self.name = nice if not vend or nice.startswith(vend) else f"{vend} {nice}"
        else:
            self.name = f"{vend or 'Unknown'} GPU"

        self.freq_paths = [p for p in (
            glob.glob(card + "/gt_act_freq_mhz") +
            glob.glob(card + "/gt/gt0/rps_act_freq_mhz") +
            glob.glob(self.dev + "/tile0/gt0/freq0/act_freq")) if os.path.exists(p)]

    @staticmethod
    def find():
        best, best_score = None, None
        for card in glob.glob("/sys/class/drm/card*"):
            if not re.fullmatch(r"card\d+", os.path.basename(card)):
                continue
            dev = card + "/device"
            vendor = read_text(dev + "/vendor")
            if not vendor:
                continue
            vram = read_int(dev + "/mem_info_vram_total", 0)
            # Prefer a discrete AMD card (most VRAM), then Intel, then anything
            score = (vendor == "0x1002", vram, vendor == "0x8086")
            if best_score is None or score > best_score:
                best, best_score = card, score
        return DrmGpu(best) if best else None

    def _hw(self, name):
        return read_int(f"{self.hwmon}/{name}") if self.hwmon else None

    def _dpm_current(self, fname):
        txt = read_text(f"{self.dev}/{fname}")
        for line in (txt or "").splitlines():
            if line.rstrip().endswith("*"):
                m = re.search(r"(\d+)\s*Mhz", line, re.I)
                if m:
                    return int(m.group(1))
        return None

    def sample(self, pids):
        res = new_gpu_stats(self.name)
        pid_util, engine_util = self.clients.sample(pids)
        res["GpuPids"] = pid_util

        busy = read_int(self.dev + "/gpu_busy_percent")
        res["Util"] = float(busy) if busy is not None else engine_util
        res["MemUtil"] = read_int(self.dev + "/mem_busy_percent")

        vtot = read_int(self.dev + "/mem_info_vram_total")
        if vtot:
            res["MemTotMB"] = vtot / MB
            res["MemUsedMB"] = (read_int(self.dev + "/mem_info_vram_used") or 0) / MB

        t = self._hw("temp1_input")
        res["Temp"] = t / 1000.0 if t is not None else None
        p = self._hw("power1_average")
        if p is None:
            p = self._hw("power1_input")
        res["PowerW"] = p / 1e6 if p is not None else None
        cap = self._hw("power1_cap")
        res["PowerCapW"] = cap / 1e6 if cap else None
        pwm = self._hw("pwm1")
        if pwm is not None:
            res["FanPct"] = pwm / (self._hw("pwm1_max") or 255) * 100.0

        sclk, mclk = self._hw("freq1_input"), self._hw("freq2_input")
        res["ClockCore"] = sclk // 1000000 if sclk else self._dpm_current("pp_dpm_sclk")
        res["ClockMem"] = mclk // 1000000 if mclk else self._dpm_current("pp_dpm_mclk")
        if not res["ClockCore"]:
            for fp in self.freq_paths:
                v = read_int(fp)
                if v:
                    res["ClockCore"] = v
                    break
        return res


def make_gpu():
    smi = shutil.which("nvidia-smi")
    if smi:
        return NvidiaGpu(smi)
    return DrmGpu.find()


# ── Battery / network / disks ────────────────────────────────────────────────

def get_battery():
    for ps in sorted(glob.glob("/sys/class/power_supply/*")):
        if read_text(ps + "/type") != "Battery" or read_text(ps + "/scope", "") == "Device":
            continue
        cap = read_int(ps + "/capacity")
        if cap is None:
            continue
        status = read_text(ps + "/status", "Unknown")
        secs = None
        if status == "Discharging":
            for now_f, rate_f in (("energy_now", "power_now"), ("charge_now", "current_now")):
                amount, rate = read_int(f"{ps}/{now_f}"), read_int(f"{ps}/{rate_f}")
                if amount and rate:
                    secs = int(amount / rate * 3600)
                    break
        return cap, status, secs
    return None


def get_net_counters():
    rx = tx = prx = ptx = 0
    phys = False
    phys_names, all_names = [], []
    with open("/proc/net/dev") as f:
        for line in f.readlines()[2:]:
            name, _, data = line.partition(":")
            name = name.strip()
            parts = data.split()
            if name == "lo" or len(parts) < 9:
                continue
            r, t = int(parts[0]), int(parts[8])
            rx, tx = rx + r, tx + t
            if r or t:
                all_names.append(name)
            # Count only physical NICs so bridges/VPN tunnels don't double-count traffic
            if os.path.exists(f"/sys/class/net/{name}/device"):
                phys = True
                prx, ptx = prx + r, ptx + t
                if r or t:
                    phys_names.append(name)
    names = phys_names if phys else all_names
    label = names[0] if len(names) == 1 else f"{len(names)} adapters" if names else ""
    return (prx, ptx, label) if phys else (rx, tx, label)


SKIP_FS = {"squashfs", "iso9660", "udf", "tmpfs", "devtmpfs", "overlay"}
SKIP_MOUNT_PREFIXES = ("/boot", "/snap/", "/var/snap/", "/run/", "/var/lib/docker",
                       "/var/lib/containers")


def _unescape_mount(s):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


def get_disks():
    mounts = []
    with open("/proc/mounts") as f:
        for line in f:
            p = line.split()
            if len(p) < 3:
                continue
            dev, mnt, fs = p[0], _unescape_mount(p[1]), p[2]
            if not dev.startswith("/dev/") or dev.startswith("/dev/loop") or fs in SKIP_FS:
                continue
            if mnt != "/" and mnt.startswith(SKIP_MOUNT_PREFIXES):
                continue
            # Read-only mounts are images/media, not disks you fill up
            if mnt != "/" and len(p) > 3 and "ro" in p[3].split(","):
                continue
            mounts.append((dev, mnt))
    # Same device mounted several times (btrfs subvolumes, bind mounts): keep the shortest path
    mounts.sort(key=lambda m: (m[1] != "/", len(m[1])))
    seen, disks = set(), []
    for dev, mnt in mounts:
        real = os.path.realpath(dev)
        if real in seen:
            continue
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        total = st.f_blocks * st.f_frsize
        if total == 0:
            continue
        seen.add(real)
        used = (st.f_blocks - st.f_bfree) * st.f_frsize
        avail = st.f_bavail * st.f_frsize
        disks.append({
            "mnt": mnt, "kname": os.path.basename(real), "total": total, "used": used,
            "pct": used / (used + avail) * 100.0 if used + avail else 0.0,
        })
    disks.sort(key=lambda d: (d["mnt"] != "/", -d["total"]))
    return disks


def get_diskstats():
    out = {}
    with open("/proc/diskstats") as f:
        for line in f:
            p = line.split()
            if len(p) >= 10:
                out[p[2]] = (int(p[5]) * 512, int(p[9]) * 512)   # sectors are always 512 B here
    return out


# ── Processes ────────────────────────────────────────────────────────────────

class Proc:
    __slots__ = ("pid", "name", "cpu", "mem_mb", "mem_pct", "threads", "io")

    def __init__(self, pid, name, cpu, mem_mb, mem_pct, threads, io):
        self.pid, self.name, self.cpu, self.mem_mb, self.mem_pct = pid, name, cpu, mem_mb, mem_pct
        self.threads = threads
        self.io = io    # disk read + write bytes/sec; None when /proc/<pid>/io isn't readable


class ProcSampler:
    PF_KTHREAD = 0x00200000

    def __init__(self):
        self.hz = os.sysconf("SC_CLK_TCK")
        self.page = os.sysconf("SC_PAGE_SIZE")
        self.prev = {}
        self.names = {}
        self.prev_io = {}
        self.io_denied = set()
        self.prev_t = time.monotonic()
        self.sample(1, 1)

    def _io_bytes(self, ent, key, denied):
        """Bytes this process has really read from + written to storage, or None.

        /proc/<pid>/io is readable only for your own processes without root. A refusal is
        remembered so other users' processes don't cost a failed open on every refresh.
        """
        if key in self.io_denied:
            denied.add(key)
            return None
        try:
            with open(f"/proc/{ent}/io", "rb") as f:
                data = f.read()
        except OSError:
            denied.add(key)
            return None
        total = 0
        for line in data.splitlines():
            if line.startswith((b"read_bytes:", b"write_bytes:")):
                try:
                    total += int(line.split()[1])
                except (IndexError, ValueError):
                    pass
        return total

    @staticmethod
    def _full_name(ent, comm):
        # comm is truncated to 15 chars by the kernel; recover the full name from argv[0]
        if len(comm) < 15:
            return comm
        try:
            with open(f"/proc/{ent}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
            base = os.path.basename(argv0.split(" ")[0])
            if base.startswith(comm):
                return base
        except OSError:
            pass
        return comm

    def sample(self, mem_total, cores):
        now = time.monotonic()
        elapsed = max(1e-3, now - self.prev_t)
        cur, names, procs, pids = {}, {}, [], []
        cur_io, denied = {}, set()
        for ent in os.listdir("/proc"):
            if not ent.isdigit():
                continue
            try:
                with open(f"/proc/{ent}/stat", "rb") as f:
                    data = f.read().decode("utf-8", "replace")
            except OSError:
                continue
            pids.append(int(ent))
            lp, rp = data.find("("), data.rfind(")")
            comm = data[lp + 1:rp]
            fields = data[rp + 2:].split()
            try:
                flags = int(fields[6])
                ticks = int(fields[11]) + int(fields[12])
                threads = int(fields[17])
                start = fields[19]
                rss = int(fields[21]) * self.page
            except (IndexError, ValueError):
                continue
            if flags & self.PF_KTHREAD:
                continue
            key = (ent, start)
            cur[key] = ticks
            cpu = 0.0
            if key in self.prev:
                cpu = max(0.0, (ticks - self.prev[key]) / self.hz / elapsed / cores * 100.0)
            name = self.names.get(key) or self._full_name(ent, comm)
            names[key] = name
            io = None
            io_bytes = self._io_bytes(ent, key, denied)
            if io_bytes is not None:
                cur_io[key] = io_bytes
                io = max(0.0, (io_bytes - self.prev_io.get(key, io_bytes)) / elapsed)
            procs.append(Proc(int(ent), name, cpu, rss / MB, rss / mem_total * 100.0, threads, io))
        self.prev, self.names, self.prev_t = cur, names, now
        self.prev_io, self.io_denied = cur_io, denied
        return procs, pids


