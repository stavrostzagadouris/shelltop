# ── Small helpers ────────────────────────────────────────────────────────────

def read_text(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except (OSError, ValueError):
        return default


def read_int(path, default=None):
    try:
        return int(read_text(path))
    except (TypeError, ValueError):
        return default


def clamp(v, lo=0.0, hi=100.0):
    return max(lo, min(hi, v))


def visible_len(s):
    return len(ANSI_RE.sub("", s))


def to_float(s):
    try:
        return float(s)
    except (TypeError, ValueError):
        return None


# ── CPU ──────────────────────────────────────────────────────────────────────

class CpuSampler:
    """Overall and per-core utilisation from /proc/stat deltas."""

    def __init__(self):
        self.prev = self._read()

    @staticmethod
    def _read():
        out = {}
        with open("/proc/stat") as f:
            for line in f:
                if not line.startswith("cpu"):
                    break
                parts = line.split()
                vals = [int(x) for x in parts[1:9]]
                vals += [0] * (8 - len(vals))
                # idle + iowait count as idle; guest time is already inside user
                out[parts[0]] = (vals[3] + vals[4], sum(vals))
        return out

    def sample(self):
        cur = self._read()

        def pct(key):
            if key not in self.prev:
                return 0.0
            d_idle = cur[key][0] - self.prev[key][0]
            d_total = cur[key][1] - self.prev[key][1]
            return clamp((d_total - d_idle) / d_total * 100.0) if d_total > 0 else 0.0

        total = pct("cpu")
        cores = sorted((k for k in cur if k != "cpu"), key=lambda k: int(k[3:]))
        per_core = [(int(k[3:]), pct(k)) for k in cores]
        self.prev = cur
        return total, per_core


def get_cpu_name():
    try:
        with open("/proc/cpuinfo") as f:
            fallback = None
            for line in f:
                key, _, val = line.partition(":")
                key, val = key.strip(), " ".join(val.split())
                if not val:
                    continue
                if key == "model name":
                    return val
                if key in ("Model", "Hardware", "cpu model") and not fallback:
                    fallback = val
            if fallback:
                return fallback
    except OSError:
        pass
    return os.uname().machine or "CPU"


def get_meminfo():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, val = line.partition(":")
            parts = val.split()
            if parts:
                m[key] = int(parts[0]) * KB
    if "MemAvailable" not in m:
        m["MemAvailable"] = m.get("MemFree", 0) + m.get("Buffers", 0) + m.get("Cached", 0)
    return m


# ── CPU sensors ──────────────────────────────────────────────────────────────

class CpuSensors:
    """CPU temperature, per-core temperatures, clock and package power, without root.

    Temperature comes from the kernel's hwmon drivers (coretemp on Intel, k10temp or
    zenpower on AMD, cpu_thermal on ARM). With none of those it falls back to a thermal
    zone; a generic ACPI zone is tagged "ACPI" in the UI because it is often not the CPU.
    Package power needs RAPL's energy counter, which most distros make root-only, so it
    only shows where that file happens to be readable.
    """
    HWMON = "/sys/class/hwmon"
    THERMAL = "/sys/class/thermal"
    CPU_SYS = "/sys/devices/system/cpu"
    RAPL = "/sys/class/powercap"
    DRIVERS = ("coretemp", "k10temp", "zenpower", "cpu_thermal")

    def __init__(self):
        self.tag = ""
        self.pkg_inputs = []     # files holding a package / die temperature
        self.core_inputs = {}    # (package id, core id) -> temp file (coretemp only)
        for hw in sorted(glob.glob(self.HWMON + "/hwmon*")):
            name = read_text(hw + "/name", "")
            if name not in self.DRIVERS:
                continue
            inputs = [(read_text(p[:-5] + "label", ""), p)
                      for p in sorted(glob.glob(hw + "/temp*_input"))]
            if name == "coretemp":
                pkg_id = 0
                for label, p in inputs:
                    m = re.fullmatch(r"Package id (\d+)", label)
                    if m:
                        pkg_id = int(m.group(1))
                        self.pkg_inputs.append(p)
                for label, p in inputs:
                    m = re.fullmatch(r"Core (\d+)", label)
                    if m:
                        self.core_inputs[(pkg_id, int(m.group(1)))] = p
                continue
            for want in ("Tdie", "Tctl"):
                hit = [p for label, p in inputs if label == want]
                if hit:
                    self.pkg_inputs.append(hit[0])
                    break
            else:
                if inputs:
                    self.pkg_inputs.append(inputs[0][1])

        if not self.pkg_inputs and not self.core_inputs:
            best = None
            for tz in sorted(glob.glob(self.THERMAL + "/thermal_zone*")):
                typ = read_text(tz + "/type", "")
                rank = 0 if typ == "x86_pkg_temp" else 1 if "cpu" in typ.lower() else \
                    2 if typ == "acpitz" else None
                if rank is not None and (best is None or rank < best[0]):
                    best = (rank, tz + "/temp")
            if best:
                self.pkg_inputs = [best[1]]
                self.tag = " ACPI" if best[0] == 2 else ""

        # Logical CPU -> (package, core), to put each core's temperature beside its bar
        self.cpu_core = {}
        if self.core_inputs:
            for d in glob.glob(self.CPU_SYS + "/cpu[0-9]*"):
                core = read_int(d + "/topology/core_id")
                if core is not None:
                    pkg = read_int(d + "/topology/physical_package_id", 0)
                    self.cpu_core[int(os.path.basename(d)[3:])] = (pkg, core)

        self.freq_paths = sorted(glob.glob(self.CPU_SYS + "/cpu[0-9]*/cpufreq/scaling_cur_freq"))
        self.rapl = [d for d in sorted(glob.glob(self.RAPL + "/intel-rapl:*"))
                     if re.fullmatch(r"intel-rapl:\d+", os.path.basename(d))
                     and read_int(d + "/energy_uj") is not None]
        self.rapl_prev = None

    @staticmethod
    def _temp(path):
        v = read_int(path)
        return v / 1000.0 if v is not None and 0 < v < 150000 else None

    def sample(self):
        res = {"Temp": None, "Tag": self.tag, "PowerW": None, "ClockMHz": None, "CoreTemps": {}}
        core_t = {k: self._temp(p) for k, p in self.core_inputs.items()}
        temps = [t for t in map(self._temp, self.pkg_inputs) if t is not None]
        if not temps:   # old CPUs have per-core sensors but no package one
            temps = [t for t in core_t.values() if t is not None]
        if temps:
            res["Temp"] = max(temps)
        for cpu, key in self.cpu_core.items():
            if core_t.get(key) is not None:
                res["CoreTemps"][cpu] = core_t[key]

        freqs = [v for v in map(read_int, self.freq_paths) if v]
        if freqs:
            res["ClockMHz"] = max(freqs) / 1000.0

        if self.rapl:
            now = time.monotonic()
            cur = [read_int(d + "/energy_uj") for d in self.rapl]
            if None in cur:
                self.rapl_prev = None
                return res
            if self.rapl_prev and now > self.rapl_prev[0]:
                joules = 0.0
                for d, old, new in zip(self.rapl, self.rapl_prev[1], cur):
                    delta = new - old
                    if delta < 0:   # the counter wrapped
                        delta += read_int(d + "/max_energy_range_uj") or 0
                    joules += delta / 1e6
                res["PowerW"] = joules / (now - self.rapl_prev[0])
            self.rapl_prev = (now, cur)
        return res


